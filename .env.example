# Connect providers in Models → API connections, or configure their keys here.
# Keys stay on the server.
# GEMINI_API_KEY: Required only for Gemini calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# OPENAI_API_KEY: Required for direct OpenAI calls.
OPENAI_API_KEY=""

# OPENROUTER_API_KEY: Required for OpenRouter calls.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
